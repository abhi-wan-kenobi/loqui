# Copy to .env.local for local dev overrides (both are gitignored by the repo root .gitignore).

# Server-side only (read by vite.config.ts): where the dev proxy forwards /ws to.
# The browser client never reads this directly — it always connects same-origin.
VITE_WS_TARGET=wss://localhost:8443

# Client-side (baked into the build): first-name used in the idle greeting.
VITE_USER_NAME=Ada
