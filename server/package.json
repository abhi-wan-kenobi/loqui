{
  "name": "@loqui/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Loqui voice-assistant server: STT -> Claude Code agent -> TTS over one WebSocket.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/*.test.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@loqui/protocol": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  }
}
